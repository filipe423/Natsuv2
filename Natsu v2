local function httpPostJson(url, jsonBody)
    local requestFn = (syn and syn.request) or request or http_request or (http and http.request)
    if requestFn then
        pcall(function()
            requestFn({
                Url = url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = jsonBody
            })
        end)
