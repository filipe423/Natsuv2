        if not renderFolder then return end
        for _, model in ipairs(renderFolder:GetChildren()) do
            hideModelIfNotMine(model)
        end
        renderFolder.ChildAdded:Connect(function(model)
            task.defer(hideModelIfNotMine, model)
        end)
        ready = true
    end)
    return ready
end

