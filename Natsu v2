                pcall(function() descendant.CollisionGroup = "GuardsNoCollide" end)
            else
                local original = guardNoCollideOriginals[descendant]
                if original then
                    pcall(function() descendant.CollisionGroup = original end)
                end
            end
        end
    end
end

