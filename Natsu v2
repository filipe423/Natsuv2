    local d = root.Position - IC_SAFE_ZONE_POS
    return Vector2.new(d.X, d.Z).Magnitude <= IC_SAFE_ZONE_RADIUS
        and math.abs(d.Y) <= IC_SAFE_ZONE_VERTICAL_TOLERANCE
end

