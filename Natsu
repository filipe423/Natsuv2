        local function snapshot()
            local ok, result = pcall(function()
                return ParasiteRemotes.AskSnapshot:InvokeServer()
            end)
            return ok and type(result) == "table" and result or nil
        end

        local function moveNearMonster(isCancelledFn)
            local monsters = workspace:FindFirstChild("MonsterParasiteMonsters")
            local monster = monsters and monsters:FindFirstChild("Monster_" .. LocalPlayer.UserId)
            local root = monster and monster:FindFirstChild("RootPart", true)
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not root or not hrp or not hum then return false end

            if (hrp.Position - root.Position).Magnitude <= 12 then
                return true
            end

            local rawTarget = (root.CFrame * CFrame.new(0, 0, 7)).Position
            local targetY = root.Position.Y + hum.HipHeight + hrp.Size.Y * 0.5
            local targetPosition = Vector3.new(rawTarget.X, targetY, rawTarget.Z)
            local lookPosition = Vector3.new(root.Position.X, targetY, root.Position.Z)

            local destCF = CFrame.lookAt(targetPosition, lookPosition)
            if Config.StealMode == "Teleport" or Config.StealMode == "Instant" then
                icTeleportHops(hrp, destCF)
            else
                TweenMoveTo(hrp, hum, destCF, isCancelledFn)
            end
            return not (isCancelledFn and isCancelledFn())
                and (hrp.Position - root.Position).Magnitude <= 14
        end

        local function claimOneChest()
            local current = snapshot()
            local pendingReward = current and current.State and current.State.PendingReward
            if type(pendingReward) == "table" and pendingReward.OpeningId then
                local revealOk, reveal = pcall(function()
                    return ParasiteRemotes.AskChestRevealComplete:InvokeServer(pendingReward.OpeningId)
                end)
                return revealOk and type(reveal) == "table" and reveal.Success == true
            end

            local function hasChestTool()
                for _, container in ipairs({LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")}) do
                    if container then
                        for _, item in ipairs(container:GetChildren()) do
                            if item:IsA("Tool") and item:GetAttribute("ItemType") == "MonsterChest" then
                                return true
                            end
                        end
                    end
                end
                return false
            end

            if not hasChestTool() then
                local takeOk, take = pcall(function()
                    return ParasiteRemotes.AskChestTake:InvokeServer()
                end)
                if not takeOk or type(take) ~= "table" or take.Success ~= true then return false end
            end

            task.wait(0.8)
            local chestTool = nil
            for _, container in ipairs({LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")}) do
                if container then
                    for _, item in ipairs(container:GetChildren()) do
                        if item:IsA("Tool") and item:GetAttribute("ItemType") == "MonsterChest" then
                            chestTool = item
                            break
                        end
                    end
                end
                if chestTool then break end
            end
            local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if not chestTool or not humanoid then return false end
            if chestTool.Parent ~= LocalPlayer.Character then
                humanoid:EquipTool(chestTool)
                task.wait(0.2)
            end

            local openingId = HttpService:GenerateGUID(false)
            local ok, result = pcall(function()
                return ParasiteRemotes.AskChestClaim:InvokeServer(openingId)
            end)
            if not ok or type(result) ~= "table" or result.Success ~= true then return false end

            openingId = result.OpeningId or openingId
            task.wait(0.8)
            local revealOk, reveal = pcall(function()
                return ParasiteRemotes.AskChestRevealComplete:InvokeServer(openingId)
            end)
            return revealOk and type(reveal) == "table" and reveal.Success == true
        end

        local function feedOneEgg()
        local uid = findFeedableParasiteEgg()
            if not uid then return false, "none" end

            local equipped = EggState.WearEggTool(uid)
            if not equipped then return false, "equip" end
            task.wait(0.2)

            if not moveNearMonster(function() return not Config.AutoParasiteFeed end) then
                return false, "movement"
            end

            local before = snapshot()
            local beforeCharge = before and before.State and before.State.Charge or 0
            local ok, result = pcall(function()
                return ParasiteRemotes.AskFeed:InvokeServer()
            end)
            if not ok or type(result) ~= "table" or result.Success ~= true then
                return false, "request"
            end

            local deadline = os.clock() + 4
            while os.clock() < deadline do
                local fresh = Save.Get()
                fresh = fresh and fresh.EggInventory and fresh.EggInventory[uid]
                if fresh and not hasMonstrousMutation(fresh) then return true end
                local state = snapshot()
                if state and state.State and state.State.Charge ~= beforeCharge then return true end
                task.wait(0.2)
            end
            return false, "timeout"
        end

        while parasiteWorkerEnabled() do
            if not parasiteWorkerEnabled() then break end
            local current = Config.AutoParasiteClaim and snapshot() or nil
            local pendingChests = current and current.State and (current.State.PendingChests or 0) or 0
            local pendingReward = current and current.State and current.State.PendingReward
            if Config.AutoParasiteClaim then
                Config.PendingParasiteReward = pendingChests > 0 or pendingReward ~= nil
            else
                Config.PendingParasiteReward = false
            end
        local shouldFeed = Config.AutoParasiteFeed and findFeedableParasiteEgg() ~= nil
            local shouldClaim = Config.AutoParasiteClaim and (pendingChests > 0 or pendingReward ~= nil)

            if (shouldFeed or shouldClaim)
                and not hasPremiumFieldEgg()
                and not hasParasiteFieldEgg()
                and not Config.IsStealing
                and not Config.IsPlacing
                and not Config.IsParasiteProcessing
            then
                Config.IsParasiteProcessing = true
                local ok, err = pcall(function()
                    local state = snapshot()
                    while Config.AutoParasiteClaim
                        and state and state.State
                        and ((state.State.PendingChests or 0) > 0 or state.State.PendingReward ~= nil)
                    do
                        if not claimOneChest() then break end
                        task.wait(0.5)
                        state = snapshot()
                    end

                    if shouldFeed then
                        while Config.AutoParasiteFeed
                            and not hasPremiumFieldEgg()
                            and not hasParasiteFieldEgg()
                        do
                            local fed = feedOneEgg()
                            if not fed then break end
                            task.wait(0.8)

                            state = snapshot()
                            if state and state.State
                                and ((state.State.PendingChests or 0) > 0 or state.State.PendingReward ~= nil)
                            then
                                break
                            end
                        end
                    end
                end)
                Config.IsParasiteProcessing = false
                if not ok then
                    warn("[AutoParasite] Error:", err)
        elseif shouldFeed and findFeedableParasiteEgg() ~= nil then
                    task.wait(1.0)
                end
            end
            task.wait(0.8)
        end

        Config.IsParasiteProcessing = false
        Config.PendingParasiteReward = false
        parasiteWorkerRunning = false
        if parasiteWorkerEnabled() then StartParasiteWorker() end
    end)
end

