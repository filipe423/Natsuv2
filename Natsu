local function isParasiteSpecies(assetCategory, record)
    local namesToCheck = {}
    if type(assetCategory) == "string" then
        table.insert(namesToCheck, assetCategory)
    end
    if type(record) == "table" then
        if type(record.AssetCategory) == "string" then table.insert(namesToCheck, record.AssetCategory) end
        if type(record.Name) == "string" then table.insert(namesToCheck, record.Name) end
        if type(record.DisplayName) == "string" then table.insert(namesToCheck, record.DisplayName) end
        if type(record.Category) == "string" then table.insert(namesToCheck, record.Category) end
        if type(record.Type) == "string" then table.insert(namesToCheck, record.Type) end
    end

    pcall(function()
        local assets = require(game:GetService("ReplicatedStorage").Data.Assets).Directory
        local cat = (type(record) == "table" and record.AssetCategory) or assetCategory
        if cat and assets and assets[cat] then
            local a = assets[cat]
            if type(a.DisplayName) == "string" then table.insert(namesToCheck, a.DisplayName) end
            if type(a.Name) == "string" then table.insert(namesToCheck, a.Name) end
            if type(a._id) == "string" then table.insert(namesToCheck, a._id) end
        end
    end)

    for _, rawName in ipairs(namesToCheck) do
        local lower = string.lower(rawName)
        if string.find(lower, "parasite", 1, true)
            or string.find(lower, "monstrous", 1, true)
            or string.find(lower, "monster", 1, true)
        then
            return true
        end
    end

    return false
end

local function hasMonstrousMutation(record)
    if type(record) ~= "table" then return false end
    if isParasiteSpecies(record.AssetCategory, record) then return false end
    
    if record.BaseMutation == "Monstrous" or record.Mutation == "Monstrous" then
        return false
    end
    if type(record.Mutations) == "table" then
        for key, mutation in pairs(record.Mutations) do
            if mutation == "Monstrous" or (key == "Monstrous" and mutation == true) then
                return false
            end
            if type(mutation) == "table" and (mutation.Id == "Monstrous" or mutation._id == "Monstrous") then
                return false
            end
        end
    end

    if record.HasParasite == true then return true end

    return false
end

local function parasiteRaritySelected(rarity)
    local selected = Config.ParasiteFeedRarities
    if type(selected) ~= "table" or #selected == 0 or table.find(selected, "None") then
        return false
    end
    return table.find(selected, "All") ~= nil or table.find(selected, rarity) ~= nil
end

local function findFeedableParasiteEgg()
    if not Config.AutoParasiteFeed or isStealNightBlocked() then return nil end

    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local profile = require(ReplicatedStorage.Shared.Save).Get()
    local inventory = profile and profile.EggInventory
    if type(inventory) ~= "table" then return nil end

    local assets = require(ReplicatedStorage.Data.Assets).Directory
    local bestUid, bestWeight = nil, -1
    for uid, record in pairs(inventory) do
        if type(record) == "table"
            and record.Placement == nil
            and record.HasParasite == true
            and not isParasiteSpecies(record.AssetCategory, record)
            and hasMonstrousMutation(record)
        then
            local asset = assets[record.AssetCategory]
            local rarity = asset and asset.Rarity
            local rarityName = rarity and (rarity.DisplayName or rarity._id) or "Unknown"
            local rarityNumber = rarity and tonumber(rarity.RarityNumber) or 0
            if parasiteRaritySelected(rarityName)
                and rarityNumber > bestWeight
            then
                bestUid = uid
                bestWeight = rarityNumber
            end
        end
    end

    return bestUid
end

